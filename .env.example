# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure local values.
# Do not commit .env to source control.
# ==============================================================================

# Application Settings
APP_NAME=travel-agency-automation
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./travel_agency.db

# Excel Integration
MAX_UPLOAD_SIZE_BYTES=10485760
AUTHORIZED_EXCEL_PATH=./data/leads.xlsx
BACKUP_DIR=./data/backups
DEFAULT_FOLLOW_UP_LIMIT=5

# Follow-up Scheduler Configuration (Phase 5)
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_POLL_INTERVAL_SECONDS=60

# Meta WhatsApp Cloud API Configuration (Phase 6 & 7)
# Toggle outbound message delivery (set to true only when ready to broadcast live messages)
WHATSAPP_ENABLED=false

# Sender Business Phone Number (Format: +[CountryCode][Digits], e.g., +919853763511)
WHATSAPP_PHONE_NUMBER=your_whatsapp_business_phone_number_here

# Meta WhatsApp Business Phone Number ID (from Meta Developer Dashboard > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# WhatsApp Business Account ID (WABA ID from Meta Business Manager > WhatsApp Accounts)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id_here

# Meta App ID (from Meta Developer Dashboard header)
META_APP_ID=your_meta_app_id_here

# Meta App Secret (from Meta Developer Dashboard > App Settings > Basic)
META_APP_SECRET=your_meta_app_secret_here

# Meta Permanent System User Access Token (from Meta Business Manager > Users > System Users)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Webhook Verification Token (custom secret string used to verify incoming Meta Webhook challenges)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API Version (e.g., v21.0)
WHATSAPP_API_VERSION=v21.0

# Meta Graph API Base Endpoint
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Authentication & Session Security (Phase 9.2)
SESSION_COOKIE_NAME=travel_crm_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=travel_crm_csrf
SETUP_SECRET=replace_with_a_secure_random_setup_secret

# HTTP Client Request Timeout in Seconds
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15.0
